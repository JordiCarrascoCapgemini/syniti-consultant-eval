# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Both passwords are mandatory: docker compose refuses to start without them.
#
# ON POCDAPP314 THIS FILE IS NOT USED. The stack is deployed by Portainer as a
# git-backed stack, and these same variable names are entered as stack
# environment variables in the Portainer UI instead. This file remains the
# reference for which variables exist, and is still how a developer laptop or
# the CLI fallback path supplies them. See deploy/DEPLOY-POCDAPP314.md section 5.

# Postgres. POSTGRES_PASSWORD has no default.
POSTGRES_DB=syniti_eval
POSTGRES_USER=syniti
POSTGRES_PASSWORD=

# The first lead account, created once at startup. Never overwritten on later
# boots, so changing this afterwards does not reset the password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Loopback port the app is published on. nginx proxies to 127.0.0.1:<APP_PORT>.
# Port allocations across apps are registered in deploy/DEPLOY-POCDAPP314.md.
APP_PORT=8001

# Host interface to publish on. Leave as 127.0.0.1 on POCDAPP314 so nginx is the
# only route in. Widen to 0.0.0.0 only on a developer machine, knowingly.
APP_BIND=127.0.0.1

# Set to the exact string "true" only when TLS terminates in front of the app.
# On POCDAPP314 nginx terminates TLS, so this MUST be true there.
# Any other value leaves the session cookie non-Secure.
COOKIE_SECURE=

# Session lifetime in seconds (default 43200 = 12 hours).
SESSION_MAX_AGE=43200
